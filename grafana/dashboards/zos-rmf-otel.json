     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(mvs_rmf_m3_mintime, sysplex)",
     "refId": "sysplex"
    },
    "definition": "label_values(mvs_rmf_m3_mintime, sysplex)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "system",
    "label": "SMF-System (Regex)",
    "type": "textbox",
    "query": ".*",
