{
 "uid": "zos-smf-zert",
 "title": "z/OS Verschlüsselung (zERT, SMF 119)",
 "tags": [
  "z/OS",
  "SMF",
  "zERT",
  "TCP/IP",
  "OpenTelemetry"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "editable": true,
