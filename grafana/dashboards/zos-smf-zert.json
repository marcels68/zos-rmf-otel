  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "system",
    "label": "System (Regex)",
    "type": "textbox",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "hide": 0
   },
   {
    "name": "jobname",
    "label": "Jobname (Regex)",
    "type": "textbox",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "hide": 0
   }
  ]
 },
