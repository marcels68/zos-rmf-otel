{
 "uid": "zos-rmf-detail",
 "title": "z/OS RMF Detail",
 "tags": [
  "z/OS",
  "RMF",
  "OpenTelemetry"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "1m",
 "editable": true,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "sysplex",
    "label": "Sysplex",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(mvs_rmf_m3_mintime, sysplex)",
     "refId": "sysplex"
    },
    "definition": "label_values(mvs_rmf_m3_mintime, sysplex)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Workload: Using und Delay je Ursache (Agent, /gpm/perform)",
