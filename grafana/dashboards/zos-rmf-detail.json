  {
   "id": 12,
   "type": "bargauge",
   "title": "Top 15 Jobs nach CPU (EAppl %)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, mvs_job_total_eappl_percent{sysplex=~\"$sysplex\"})",
     "legendFormat": "{{sysname}}.{{job_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "transformations": [],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "(?i).*port.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "valueMode": "color",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "minVizHeight": 10,
    "maxVizHeight": 24,
    "sizing": "manual"
   }
  },
