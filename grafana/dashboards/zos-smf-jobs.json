  },
  {
   "id": 2,
   "type": "stat",
   "title": "Jobs beendet",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({service_name=\"zos-smf-30\"} | zos_smf_id=~\"$system\" | smf_record_subtype=\"5\" | zos_job_name=~\"$jobname\" [$__range]))",
     "legendFormat": "",
