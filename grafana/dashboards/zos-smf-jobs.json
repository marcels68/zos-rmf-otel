   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (zos_job_name) (sum_over_time({service_name=\"zos-smf-30\"} | zos_smf_id=~\"$system\" | smf_record_subtype=\"5\" | zos_job_name=~\"$jobname\" | unwrap smf30_cpu_total_seconds | __error__=\"\" [$__range])))",
     "legendFormat": "{{zos_job_name}}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "instant": true,
     "queryType": "instant",
     "format": "time_series"
    }
   ],
   "transformations": [
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Value #A",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "(?i).*port.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "valueMode": "color",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": true
    },
    "minVizHeight": 10,
    "maxVizHeight": 24,
    "sizing": "manual"
