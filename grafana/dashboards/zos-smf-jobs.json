{
 "uid": "zos-smf-jobs",
 "title": "z/OS Jobs (SMF 30)",
 "tags": [
  "z/OS",
  "SMF",
  "OpenTelemetry"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "system",
    "label": "System (Regex)",
    "type": "textbox",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "hide": 0
   },
   {
    "name": "jobname",
    "label": "Jobname (Regex)",
    "type": "textbox",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "hide": 0
   }
  ]
 },
