# Kopieren nach .env (wird nicht eingecheckt) und ausfüllen.
RMF_DDS_HOST=ddshost.example.com:8803
RMF_DDS_SCHEME=https
RMF_DDS_USER=DDSUSER
RMF_DDS_PASSWORD=
# Monitor-III-MINTIME des Systems (steht in /metrics/m3 als mvs_rmf_m3_mintime)
RMF_INTERVAL=60
RMF_SCRAPE_INTERVAL=60s
RMF_SCRAPE_TIMEOUT=30s
